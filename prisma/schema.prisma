// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Admin user model
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Collection (Gallery) model
model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  slug        String   @unique
  status      String   @default("draft") // draft | published
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("collections")
}

// Product model
model Product {
  id           String   @id @default(cuid())
  name         String
  description  String?
  price        Float
  stockUrgency String? // Optional stock urgency message
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  images   Image[]
  variants Variant[]

  @@map("products")
}

// Variant model for product variations
model Variant {
  id         String   @id @default(cuid())
  name       String
  color      String
  stockCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("variants")
}

// Image model
model Image {
  id           String   @id @default(cuid())
  url          String
  alt          String?
  cloudinaryId String? // For deletion from Cloudinary
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("images")
}
